# Copy to .env (or export these in your shell) before running.

# PostgreSQL (matches ../schema.sql). If unset, a local SQLite file is used for development.
# DATABASE_URL=postgresql://taskdawg:password@localhost:5432/taskdawg
DATABASE_URL=sqlite:///./taskdawg.db

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# How long a login token stays valid, in minutes (default 1440 = 24 hours).
ACCESS_TOKEN_MINUTES=1440

# Comma-separated list of front-end origins allowed to call the API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Create missing tables on startup. Set to false if you manage the schema with SQL files.
AUTO_CREATE_TABLES=true
